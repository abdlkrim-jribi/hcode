{
    "productName": "Hcode",
    "version": "0.1.0",
    "identifier": "com.hcode.desktop",
    "build": {
        "frontendDist": "../src-ui/dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run ui:dev",
        "beforeBuildCommand": "npm run ui:build"
    },
    "app": {
        "windows": [
            {
                "title": "Hcode — AI Coding Agent",
                "width": 1400,
                "height": 900,
                "minWidth": 900,
                "minHeight": 600,
                "decorations": true,
                "resizable": true,
                "center": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'"
        }
    }
}