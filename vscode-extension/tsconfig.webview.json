{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "outDir": "./webview_build",
        "rootDir": "./src/webview",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "resolveJsonModule": true
    },
    "include": [
        "src/webview/**/*.ts",
        "src/webview/**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}