{
    "name": "vscode-hcode",
    "displayName": "Hcode AI Coding Agent",
    "description": "Integrates the Hcode AI coding agent into VS Code with a full Plan → Approve → Execute → Verify workflow.",
    "version": "0.1.0",
    "publisher": "hcode-dev",
    "license": "MIT",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "AI",
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "ai",
        "coding",
        "agent",
        "hcode",
        "llm"
    ],
    "icon": "media/icon.png",
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "hcode.runTask",
                "title": "Hcode: Run Task",
                "icon": "$(play)"
            },
            {
                "command": "hcode.openChat",
                "title": "Hcode: Open Chat",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "hcode.openSettings",
                "title": "Hcode: Settings",
                "icon": "$(settings-gear)"
            },
            {
                "command": "hcode.explainSelection",
                "title": "Hcode: Explain",
                "category": "Ask Hcode"
            },
            {
                "command": "hcode.refactorSelection",
                "title": "Hcode: Refactor",
                "category": "Ask Hcode"
            },
            {
                "command": "hcode.optimizeSelection",
                "title": "Hcode: Optimize",
                "category": "Ask Hcode"
            },
            {
                "command": "hcode.addTestsForSelection",
                "title": "Hcode: Add Tests",
                "category": "Ask Hcode"
            },
            {
                "command": "hcode.fixBugSelection",
                "title": "Hcode: Fix Bug",
                "category": "Ask Hcode"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "hcode.runTask"
                },
                {
                    "command": "hcode.openChat"
                },
                {
                    "command": "hcode.openSettings"
                },
                {
                    "command": "hcode.explainSelection",
                    "when": "editorHasSelection"
                },
                {
                    "command": "hcode.refactorSelection",
                    "when": "editorHasSelection"
                },
                {
                    "command": "hcode.optimizeSelection",
                    "when": "editorHasSelection"
                },
                {
                    "command": "hcode.addTestsForSelection",
                    "when": "editorHasSelection"
                },
                {
                    "command": "hcode.fixBugSelection",
                    "when": "editorHasSelection"
                }
            ],
            "editor/context": [
                {
                    "command": "hcode.explainSelection",
                    "when": "editorHasSelection",
                    "group": "hcode@1"
                },
                {
                    "command": "hcode.refactorSelection",
                    "when": "editorHasSelection",
                    "group": "hcode@2"
                },
                {
                    "command": "hcode.optimizeSelection",
                    "when": "editorHasSelection",
                    "group": "hcode@3"
                },
                {
                    "command": "hcode.addTestsForSelection",
                    "when": "editorHasSelection",
                    "group": "hcode@4"
                },
                {
                    "command": "hcode.fixBugSelection",
                    "when": "editorHasSelection",
                    "group": "hcode@5"
                }
            ]
        },
        "configuration": {
            "title": "Hcode",
            "properties": {
                "hcode.cliPath": {
                    "type": "string",
                    "default": "hcode",
                    "description": "Path to the hcode CLI executable."
                },
                "hcode.autonomousMode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable autonomous mode (skips approval gates). Use with caution."
                },
                "hcode.provider": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "openai",
                        "anthropic",
                        "cerebras"
                    ],
                    "default": "auto",
                    "description": "AI provider to use."
                },
                "hcode.workingDirectory": {
                    "type": "string",
                    "default": "",
                    "description": "Working directory for hcode (defaults to workspace root)."
                }
            }
        },
        "viewsContainers": {
            "secondarySidebar": [
                {
                    "id": "hcode-explorer",
                    "title": "Hcode",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "hcode-explorer": [
                {
                    "id": "hcode.sidebar",
                    "type": "webview",
                    "name": "Hcode: Control",
                    "icon": "$(robot)"
                },
                {
                    "id": "hcode.history",
                    "type": "webview",
                    "name": "Hcode: History",
                    "icon": "$(history)"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "compile": "tsc -p tsconfig.json",
        "watch": "tsc -watch -p tsconfig.json",
        "build": "npm run compile && npm run build:webview",
        "build:webview": "npx vite build --config vite.config.ts",
        "test": "jest --testPathPattern=test/unit",
        "test:e2e": "node ./test/e2e/runTests.js",
        "lint": "eslint src --ext ts,tsx",
        "package": "npx @vscode/vsce package"
    },
    "dependencies": {
        "simple-git": "^3.22.0"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/jest": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/vscode": "^1.85.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitejs/plugin-react": "^4.0.0",
        "@vscode/test-electron": "^2.3.0",
        "@vscode/vsce": "^2.22.0",
        "eslint": "^8.0.0",
        "glob": "^8.1.0",
        "jest": "^29.0.0",
        "marked": "^11.2.0",
        "mocha": "^11.3.0",
        "monaco-editor": "^0.44.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "ts-jest": "^29.0.0",
        "typescript": "^5.3.0",
        "vite": "^7.3.1"
    }
}