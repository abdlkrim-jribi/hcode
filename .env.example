# Hcode Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI GPT API Key
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Custom OpenAI API Base URL
# Useful for Azure OpenAI, proxies, or OpenAI-compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1  # Default OpenAI
# OPENAI_BASE_URL=https://your-org.openai.azure.com/  # Azure OpenAI
# OPENAI_BASE_URL=http://localhost:8000/v1  # Local proxy/compatible API

# Optional: Override provider preference
# HCODE_PROVIDER=auto  # Options: auto, anthropic, openai

# Optional: Model Selection (Choose ONE of the following approaches)

# Approach 1: Universal model for all providers (RECOMMENDED)
# HCODE_MODEL=llama3.1-70b  # Will use this model regardless of provider

# Approach 2: Provider-specific models
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # Specific Claude model
# OPENAI_MODEL=gpt-4o  # Specific OpenAI/compatible model

# Approach 3: Model size aliases (auto-selects best model for provider)
# HCODE_MODEL_SIZE=mid  # Options: small, mid, big
# small: Fast & economical (Haiku, GPT-4o-mini, llama3.1-8b)
# mid: Balanced performance (Sonnet, GPT-4o, llama3.1-70b)
# big: Maximum capability (Opus, GPT-4-turbo, llama3.1-70b)

# Priority: HCODE_MODEL > ANTHROPIC_MODEL/OPENAI_MODEL > HCODE_MODEL_SIZE > defaults

# Optional: Override cost optimization
# HCODE_OPTIMIZE_COST=balanced  # Options: aggressive, balanced, quality
