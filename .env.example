# Hcode Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic Claude API Key
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI GPT API Key
OPENAI_API_KEY=

# Optional: Custom OpenAI API Base URL
# Useful for Azure OpenAI, proxies, or OpenAI-compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1  # Default OpenAI
# OPENAI_BASE_URL=https://your-org.openai.azure.com/  # Azure OpenAI


# Optional: Disable SSL verification for internal/self-signed certificates
# Set to false if your API uses a certificate from an internal CA
OPENAI_VERIFY_SSL=false

# Optional: Override provider preference
HCODE_PROVIDER=openai  # Options: auto, anthropic, openai

# Optional: Model Selection
# Use this to specify which model to use
# Available models depend on your API endpoint
OPENAI_MODEL=gpt-oss

# Optional: Override cost optimization
HCODE_OPTIMIZE_COST=aggressive  # Options: aggressive, balanced, quality
